# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/shield-ecommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Frontend (for CORS & redirects). Comma-separated for multiple URLs (e.g. Vercel prod + preview).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Google OAuth (create your own at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment (eSewa)
ESEWA_CLIENT_ID=
ESEWA_SECRET_KEY=
ESEWA_ENV=development

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (invoice + contact — use real values only in private .env, never commit them)
# On many hosts (Render) Gmail SMTP often hits connection timeouts — use Resend HTTPS as primary:
# https://resend.com/signup → API Keys → paste below. Use RESEND_FROM=Shield <you@verified-domain>.
RESEND_API_KEY=
RESEND_FROM=

# SMTP optional / fallback — Gmail needs 2FA + App Password. SMTP_FROM usually equals SMTP_USER.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
# Optional: receive a BCC copy of every outgoing mail (comma-separated, for debugging deliverability)
SMTP_BCC=
SUPPORT_EMAIL=
# Optional: increase if slow networks (ms)
# SMTP_SOCKET_TIMEOUT_MS=55000
# SMTP_RETRY_ATTEMPTS=4
